{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{public/**,descargas/**,node_modules/pdfkit/js/data/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/f/:token", "destination": "/api" },
    { "source": "/descargas/:file*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}