# Copia este archivo a .env (nunca se sube al repositorio) y rellena los valores.

# --- Servidor ---
# PORT=3000
# JWT_SECRET=        # mínimo 32 caracteres; obligatorio en producción
# ADMIN_PASSWORD=    # clave del administrador inicial; si falta se genera una y se muestra una vez
# CORS_ORIGIN=       # orígenes permitidos separados por comas (solo si el frontend vive en otro dominio)

# --- Base de datos ---
# Supabase (Connect -> Session pooler). Con esta variable NO se usa SQLite: si Supabase no responde, el servidor se detiene.
# DATABASE_URL=postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres
# PGSSL_CA=          # ruta al certificado de Supabase para verificar el servidor (opcional)
# Sin DATABASE_URL: Postgres local (PGHOST, PGUSER, PGPASSWORD, PGDATABASE, PGPORT) o, si no responde, SQLite.

# --- Supabase Storage (fotos de las etiquetas) ---
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...     # clave SECRETA: solo en el servidor, nunca en la app ni en el navegador
# SUPABASE_BUCKET_FOTOS=etiquetas-fotos
# SUPABASE_BUCKET_DOCUMENTOS=documentos   # cédulas, RIF, packing lists y fotos adjuntas
# Sin estas dos variables las fotos se guardan en uploads/etiquetas/ (solo para desarrollo).

# --- App móvil ---
# APP_WHATSAPP=      # número con código de país para el botón "Escribir a mi asesora"

# --- Enlaces de facturas (WhatsApp) ---
# PUBLIC_URL=https://tu-dominio.com   # dominio público del sistema; los enlaces a PDF se arman con él


# --- Lector de packing list con IA (cualquier proveedor compatible con la API de OpenAI) ---
# IA_PROVEEDOR=gemini   # openai | gemini | ollama | deepseek (DeepSeek no lee fotos: solo Excel/CSV)
# IA_API_KEY=           # clave del proveedor; Ollama local no la necesita
# IA_MODELO=            # opcional; varios separados por comas se prueban en orden si uno está saturado (deben aceptar imágenes)
# IA_BASE_URL=          # opcional: otra URL compatible, ej. http://192.168.1.20:11434/v1 para un Ollama en otra máquina
# IA_ESPERA_SEGUNDOS=   # opcional: espera máxima de la respuesta (90 s; 300 s con Ollama)

# --- Vercel ---
# Ver VERCEL.md: variables solo en Production; la cadena DATABASE_URL debe ser la del pooler (puerto 6543).
